{
  "name": "@beatbrackerz/eventstore",
  "version": "1.2.0",
  "description": "Reusable event store implementation for Supabase with optimized performance and support for event sourcing patterns.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "sql"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:pkg": "node -e \"const fs=require('fs');fs.writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}));fs.writeFileSync('dist/esm/package.json',JSON.stringify({type:'module'}))\"",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:pkg",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "bench": "node bench/run.ts",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.91.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^22.20.4",
    "ioredis": "^6.0.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beatbrackerz/eventstore.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "license": "MIT",
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
